# Preferred: Groq for POST /api/explain (server only — never expose in the browser bundle).
GROQ_API_KEY=

# Optional fallback: Gemini key if you prefer Google models.
GEMINI_API_KEY=

# Port for the local Express API (default 8787).
API_PORT=8787

# Lucky Orange live API (when your paid API plan is active).
# These are consumed by the frontend sync button.
LO_API_BASE_URL=
LO_API_KEY=
# Optional override for API endpoint path used by sync.
LO_API_ENDPOINT=/v1/analytics/pages

# Set to true when the API is running so Vite proxies /api (e.g. npm run dev:full).
# Leave unset or false for npm run dev only — avoids ECONNREFUSED to :8787.
ENABLE_API_PROXY=
